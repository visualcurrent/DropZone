<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The same set DropZone's app holds, for the same reasons. -->

    <!-- Open a listening socket and find the phone's WiFi address. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Keep the server alive after the user leaves the app. Android 14+ makes
         every foreground service declare a type; "connectedDevice" requires
         CHANGE_WIFI_STATE (or a sibling permission) to be held. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Keep CPU and WiFi awake during a transfer with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Show the "DropCast is running" notification on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- usesCleartextTraffic: the app's screen is a page loaded from the server
         on this same phone over plain http (http://127.0.0.1:7071). Android
         blocks plain http inside an app unless this is set. -->
    <application
        android:label="DropCast"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- singleTask: sharing a second file while the app is already open
             reuses this one screen (onNewIntent) instead of stacking another. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <!-- Way in 1: the app's own icon. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Way in 2: the share menu, for ONE item of any type.
                 SEND_MULTIPLE is deliberately not listed, so DropCast is not
                 offered when several files are selected (PLAN M2: one file
                 per share). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".CastService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
