<?xml version="1.0" encoding="utf-8"?>
<!-- The DropZone logo, same three strokes as LOGO_SVG in DropZone.py (a tray
     with an arrow rising out of it). Drawn white; MainActivity tints it to the
     theme's teal at runtime, so one file serves light and dark mode. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="26dp"
    android:height="26dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- tray -->
    <path
        android:pathData="M4,12v8a2,2 0,0 0,2 2h12a2,2 0,0 0,2 -2v-8"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- arrow head -->
    <path
        android:pathData="M16,6L12,2L8,6"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- arrow shaft -->
    <path
        android:pathData="M12,2L12,15"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
</vector>
